{
  "name": "tom-pokemon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.dev.json",
